// Crow enclosure: OpenSCAD version of cad/build.mjs, same parameters (mm).
// Pick a part, press F6, then File > Export > STL.
// The STL files in cad/stl/ were generated by cad/build.mjs; this file is for editing.

PART = "assembly";   // "shell" | "floor" | "foot" | "tuft" | "assembly"
$fn = 48;

// ---- outside of the shell
W = 96; D = 70; H = 78;
RV = 14;   // plan corner radius
RT = 5;    // top edge radius
T = 2.4;   // wall
FLOOR = 3; FIT = 0.3;

// ---- face + front
WIN_W = 25; WIN_H = 14; WIN_Z = 56; WIN_R = 1.5;   // OLED window
OLED_PCB = 28.4; OLED_POCKET_DEPTH = 4;
OLED_OFFSET_Z = 0;   // nudge if your module's glass sits off-centre on its board
LED_Z = 36; LED_D = 5.2;
GRILL_Z = 20; GRILL_R = 10; GRILL_HOLE = 2.0; GRILL_PITCH = 3.6;
BUZZER_D = 12.4; BUZZER_CUP = 5;

// ---- top, sides, back
PERCH_D = 16.2; PERCH_Y = 6;                 // 16 mm panel-mount momentary button
TUFT_X = -26; TUFT_Y = -14; TUFT_SLOT = [12, 3.2];
PIN_Y = 0; PIN_Z = 56; PIN_D = 2.2;          // SOS pinhole, right side
BOARD_X = -20; BOARD_W = 25.4; BOARD_L = 57; // LOLIN D32 class board, USB to the back
USB_Z = 8; USB_W = 13; USB_H = 9;
BATT = [34, 50, 10]; BATT_X = 17;            // 103450 LiPo
POST_D = 8; POST_HOLE = 2.6; POST_TOP = 15; CSK_D = 5.6;

// ---- derived
IN_W = W - 2 * T; IN_D = D - 2 * T; IN_RV = RV - T; IN_RT = RT - T;
FRONT = -D / 2; BACK = D / 2; RIGHT = W / 2;
FIN = FRONT + T; BIN = BACK - T; RIN = RIGHT - T; LIN = -RIGHT + T;
POST_OFF = (IN_RV - POST_D / 2 + 0.4) / sqrt(2);
POSTS = [for (s = [[1, 1], [-1, 1], [-1, -1], [1, -1]]) [s[0] * (W / 2 - RV + POST_OFF), s[1] * (D / 2 - RV + POST_OFF)]];

// plan corners radius rv, top edges radius rt, flat bottom at z0
module rounded_box(w, d, z0, z1, rv, rt) {
  hull() for (sx = [-1, 1], sy = [-1, 1]) translate([sx * (w / 2 - rv), sy * (d / 2 - rv), 0]) {
    translate([0, 0, z0]) cylinder(r = rv, h = 0.01);
    translate([0, 0, z1 - rt]) rotate_extrude() translate([rv - rt, 0]) intersection() { circle(r = rt); square([rt, rt]); }
  }
}

module shell() {
  difference() {
    union() {
      difference() {
        rounded_box(W, D, 0, H, RV, RT);
        rounded_box(IN_W, IN_D, -1, H - T, IN_RV, IN_RT);
      }
      // screw posts, each with a 45 degree cone so the shell prints upside down without supports
      for (p = POSTS) {
        translate([p[0], p[1], FLOOR]) cylinder(d = POST_D, h = POST_TOP - FLOOR);
        k = 3.6 / sqrt(2);
        hull() {
          translate([p[0], p[1], POST_TOP]) cylinder(d = POST_D, h = 0.01);
          translate([p[0] + sign(p[0]) * k, p[1] + sign(p[1]) * k, POST_TOP + POST_D + 0.2]) cylinder(r = 0.3, h = 0.01);
        }
      }
      // OLED pocket (top left open for the header and wires)
      oz = WIN_Z + OLED_OFFSET_Z; half = OLED_PCB / 2; fw = 1.6;
      y0 = FIN - 0.4; y1 = FIN + OLED_POCKET_DEPTH;
      translate([-half - fw, y0, oz - half - fw]) cube([OLED_PCB + 2 * fw, y1 - y0, fw]);
      translate([-half - fw, y0, oz - half - fw]) cube([fw, y1 - y0, OLED_PCB + fw - 4]);
      translate([half, y0, oz - half - fw]) cube([fw, y1 - y0, OLED_PCB + fw - 4]);
      // buzzer cup behind the grill
      translate([0, FIN - 0.4, GRILL_Z]) rotate([-90, 0, 0]) difference() {
        cylinder(r = BUZZER_D / 2 + 1.4, h = BUZZER_CUP + 0.4);
        translate([0, 0, -1]) cylinder(d = BUZZER_D, h = BUZZER_CUP + 3);
      }
      // SOS switch boss: a 6x6 mm tact switch drops in from the inside, button facing the pinhole
      difference() {
        translate([RIN - 5, PIN_Y - 5, PIN_Z - 5]) cube([5.4, 10, 10]);
        translate([RIN - 6, PIN_Y - 3.2, PIN_Z - 3.2]) cube([6.01, 6.4, 6.4]);
      }
      // RTC ledge on the left wall
      translate([LIN - 0.4, -19, 21]) cube([4.4, 38, 2]);
    }
    // window
    translate([0, FRONT - 1, WIN_Z]) rotate([-90, 0, 0]) linear_extrude(T + 2)
      offset(r = WIN_R) square([WIN_W - 2 * WIN_R, WIN_H - 2 * WIN_R], center = true);
    // rage LED
    translate([0, FRONT - 1, LED_Z]) rotate([-90, 0, 0]) cylinder(d = LED_D, h = T + 2);
    // grill (skips holes that would hit the buzzer cup wall)
    for (row = [-4:4], col = [-4:4]) {
      x = (col + (row % 2 != 0 ? 0.5 : 0)) * GRILL_PITCH;
      z = row * GRILL_PITCH * 0.866;
      r = sqrt(x * x + z * z);
      if (r <= GRILL_R && !(r + GRILL_HOLE / 2 > BUZZER_D / 2 - 0.2 && r - GRILL_HOLE / 2 < BUZZER_D / 2 + 1.6))
        translate([x, FRONT - 1, GRILL_Z + z]) rotate([-90, 0, 0]) cylinder(d = GRILL_HOLE, h = T + 2, $fn = 12);
    }
    // perch button, tuft slot, SOS pinhole
    translate([0, PERCH_Y, H - T - 1]) cylinder(d = PERCH_D, h = T + 2, $fn = 64);
    translate([TUFT_X - TUFT_SLOT[0] / 2, TUFT_Y - TUFT_SLOT[1] / 2, H - T - 1]) cube([TUFT_SLOT[0], TUFT_SLOT[1], T + 2]);
    translate([RIN - 1, PIN_Y, PIN_Z]) rotate([0, 90, 0]) cylinder(d = PIN_D, h = T + 2, $fn = 16);
    // USB opening and back vents
    translate([BOARD_X, BACK + 1, USB_Z]) rotate([90, 0, 0]) linear_extrude(T + 2)
      hull() for (sx = [-1, 1]) translate([sx * (USB_W - USB_H) / 2, 0]) circle(d = USB_H);
    for (x = [8, 18, 28]) translate([x, BACK + 1, 48]) rotate([90, 0, 0]) linear_extrude(T + 2)
      hull() for (sy = [-1, 1]) translate([0, sy * 8]) circle(d = 2.4);
    // pilot holes for M3 self-tapping screws
    for (p = POSTS) translate([p[0], p[1], FLOOR - 0.1]) cylinder(d = POST_HOLE, h = 10, $fn = 16);
  }
}

module floor_plate() {
  c = FIT;
  hw = BOARD_W / 2 + 0.3; yb = BIN - 1.5; yf = yb - BOARD_L;
  difference() {
    union() {
      linear_extrude(FLOOR) offset(r = IN_RV - c)
        square([IN_W - 2 * c - 2 * (IN_RV - c), IN_D - 2 * c - 2 * (IN_RV - c)], center = true);
      // board cradle: rails with a 2 mm ledge, plus a front stop
      for (s = [-1, 1]) {
        e = BOARD_X + s * hw;
        translate([min(e, e + s * 1.6), yf + 2, FLOOR - 0.1]) cube([1.6, (yb - 1) - (yf + 2), 6.1]);
        translate([min(e, e - s * 2), yf + 2, FLOOR - 0.1]) cube([2, (yb - 1) - (yf + 2), 2.1]);
      }
      translate([BOARD_X - 6, yf - 1.6, FLOOR - 0.1]) cube([12, 1.6, 5.1]);
      // battery corral
      for (s = [-1, 1]) {
        e = BATT_X + s * (BATT[0] / 2 + 0.5);
        translate([min(e, e + s * 1.6), -BATT[1] / 2 + 5, FLOOR - 0.1]) cube([1.6, BATT[1] - 10, 5.1]);
      }
    }
    // countersunk M3 holes under the posts
    for (p = POSTS) {
      translate([p[0], p[1], -1]) cylinder(d = 3.4, h = FLOOR + 2, $fn = 20);
      translate([p[0], p[1], -0.01]) cylinder(d1 = CSK_D, d2 = 3.4, h = CSK_D / 2 - 1.7 + 0.01, $fn = 20);
    }
    // notch for the battery lead
    translate([-4.5, -6, FLOOR - 0.5]) cube([4, 12, 6.5]);
  }
}

module foot() {
  linear_extrude(3) union() {
    for (t = [[-28, 15], [0, 17], [28, 15]]) hull() { circle(d = 4.6); rotate(-90 + t[0]) translate([t[1], 0]) circle(d = 4.6); }
    translate([0, 1.3]) circle(r = 5.6);
    hull() { circle(d = 4); translate([0, 9]) circle(d = 4); }
  }
}

module tuft() {
  linear_extrude(3) union() {
    for (f = [[-24, 14, 4.6], [0, 17, 5], [22, 11, 4.4]]) hull() { circle(d = f[2]); rotate(90 + f[0]) translate([f[1], 0]) circle(d = f[2]); }
    hull() { translate([-5, 0]) circle(d = 5); translate([5, 0]) circle(d = 5); }
    translate([-(TUFT_SLOT[0] - 0.4) / 2, -4.5]) square([TUFT_SLOT[0] - 0.4, 5]);
  }
}

module assembly() {
  color("#2b2d36") shell();
  color("#3a3d48") floor_plate();
  for (x = [-20, 20]) color("#ffad3b") translate([x, FRONT + 9, -3]) foot();
  color("#2b2d36") translate([TUFT_X, TUFT_Y + 1.5, H]) rotate([90, 0, 0]) tuft();
  color("#d9ad55") translate([0, PERCH_Y, H]) cylinder(d = 18, h = 5);
}

if (PART == "shell") translate([0, 0, H]) rotate([180, 0, 0]) shell();   // print orientation: top on the bed
else if (PART == "floor") floor_plate();
else if (PART == "foot") foot();
else if (PART == "tuft") tuft();
else assembly();
